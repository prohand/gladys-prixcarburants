          }
        },
        {
          "key": "city",
          "type": "string",
          "label": {
            "en": "City",
            "fr": "Ville"
          }
        },
        {
          "key": "fuel",
          "type": "string",
          "label": {
            "en": "Fuel key",
            "fr": "Clé du carburant"
          }
        },
        {
          "key": "fuel_label",
          "type": "string",
          "label": {
            "en": "Fuel",
            "fr": "Carburant"
          }
        },
        {
          "key": "price",
          "type": "number",
          "label": {
            "en": "New price (EUR/L)",
            "fr": "Nouveau prix (EUR/L)"
          }
        },
        {
          "key": "previous_price",
          "type": "number",
          "label": {
            "en": "Previous price (EUR/L)",
            "fr": "Prix précédent (EUR/L)"
          }
        },
        {
          "key": "price_difference",
          "type": "number",
          "label": {
            "en": "Difference (EUR/L)",
            "fr": "Écart (EUR/L)"
          }
        },
        {
          "key": "direction",
          "type": "string",
          "label": {
            "en": "Direction (down/up)",
            "fr": "Sens (down/up)"
          }
        },
        {
          "key": "updated_at",
          "type": "string",
          "label": {
            "en": "Declared on",
            "fr": "Déclaré le"
          }
        }
      ]
    },
    {
      "key": "cheapest_station_changed",
      "label": {
        "en": "The cheapest station changed",
        "fr": "La station la moins chère a changé"
      },
      "description": {
        "en": "Among the stations you follow, another one is now the cheapest for a fuel. Needs at least two stations followed for that fuel.",
        "fr": "Parmi les stations que vous suivez, une autre est désormais la moins chère pour un carburant. Il faut suivre au moins deux stations pour ce carburant."
      },
      "fields": [
        {
          "key": "fuel",
          "type": "select",
          "label": {
            "en": "Fuel",
            "fr": "Carburant"
          },
          "description": {
            "en": "Leave empty for any fuel.",
            "fr": "Laissez vide pour tous les carburants."
          },
          "options": [
            {
              "value": "gazole",
              "label": {
                "en": "Diesel",
                "fr": "Gazole"
              }
            },
            {
              "value": "sp95",
              "label": {
                "en": "SP95",
