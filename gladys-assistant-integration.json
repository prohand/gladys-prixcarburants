        },
        {
          "key": "price_difference",
          "type": "number",
          "label": {
            "en": "Difference (EUR/L)",
            "fr": "Écart (EUR/L)"
          }
        },
        {
          "key": "station_count",
          "type": "number",
          "label": {
            "en": "Stations compared",
            "fr": "Stations comparées"
          }
        }
      ]
    },
    {
      "key": "feed_status_changed",
      "label": {
        "en": "The open data feed became reachable / unreachable",
        "fr": "Le flux open data est devenu joignable / injoignable"
      },
      "description": {
        "en": "Every station of a refresh failed, or the feed answers again after a failure. The transition is fired once, not at every refresh.",
        "fr": "Toutes les stations d'un rafraîchissement ont échoué, ou le flux répond de nouveau après une panne. La transition est émise une fois, pas à chaque rafraîchissement."
      },
      "fields": [
        {
          "key": "status",
          "type": "select",
          "label": {
            "en": "Status",
            "fr": "État"
          },
          "description": {
            "en": "Leave empty for both.",
            "fr": "Laissez vide pour les deux."
          },
          "options": [
            {
              "value": "unavailable",
              "label": {
                "en": "The feed stopped answering",
                "fr": "Le flux ne répond plus"
              }
            },
            {
              "value": "available",
              "label": {
                "en": "The feed answers again",
                "fr": "Le flux répond de nouveau"
              }
