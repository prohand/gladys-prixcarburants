              }
            },
            {
              "value": "sp98",
              "label": {
                "en": "SP98",
                "fr": "SP98"
              }
            },
            {
              "value": "e10",
              "label": {
                "en": "E10 (SP95-E10)",
                "fr": "E10 (SP95-E10)"
              }
            },
            {
              "value": "e85",
              "label": {
                "en": "E85 (Superethanol)",
                "fr": "E85 (Superéthanol)"
              }
            },
            {
              "value": "gplc",
              "label": {
                "en": "LPG",
                "fr": "GPLc"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "station_name",
          "type": "string",
          "label": {
            "en": "New cheapest station",
            "fr": "Nouvelle station la moins chère"
          }
        },
        {
          "key": "city",
          "type": "string",
          "label": {
            "en": "City",
            "fr": "Ville"
          }
        },
        {
          "key": "fuel",
          "type": "string",
          "label": {
            "en": "Fuel key",
            "fr": "Clé du carburant"
          }
        },
        {
          "key": "fuel_label",
          "type": "string",
          "label": {
            "en": "Fuel",
            "fr": "Carburant"
          }
        },
        {
          "key": "price",
          "type": "number",
          "label": {
            "en": "Its price (EUR/L)",
            "fr": "Son prix (EUR/L)"
          }
        },
        {
          "key": "previous_station_name",
          "type": "string",
          "label": {
            "en": "Previous cheapest station",
            "fr": "Précédente station la moins chère"
