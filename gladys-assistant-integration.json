  "scene_actions": [
    {
      "key": "refresh_prices",
      "label": {
        "en": "Refresh the fuel prices",
        "fr": "Rafraîchir les prix des carburants"
      },
      "description": {
        "en": "Read the open data feed now, so the next steps of the scene do not act on an hour-old price.",
        "fr": "Lit le flux open data maintenant, pour que la suite de la scène ne travaille pas sur un prix vieux d'une heure."
      },
      "timeout_seconds": 60,
      "outputs": [
        {
          "key": "total",
          "type": "number",
          "label": {
            "en": "Stations read",
            "fr": "Stations lues"
          }
        },
        {
          "key": "updated",
          "type": "number",
          "label": {
            "en": "Prices updated",
            "fr": "Prix mis à jour"
          }
        },
        {
          "key": "failed",
          "type": "number",
          "label": {
            "en": "Stations that failed",
            "fr": "Stations en échec"
          }
        }
      ]
    },
    {
      "key": "cheapest_station",
      "label": {
        "en": "Find the cheapest station",
        "fr": "Trouver la station la moins chère"
      },
      "description": {
        "en": "Compares the stations you follow for one fuel and returns the cheapest one. Answers found = false when you follow none for that fuel.",
        "fr": "Compare les stations que vous suivez pour un carburant et renvoie la moins chère. Renvoie found = false si vous n'en suivez aucune pour ce carburant."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "fuel",
          "type": "select",
          "label": {
            "en": "Fuel",
            "fr": "Carburant"
          },
          "required": true,
          "default": "gazole",
          "options": [
            {
              "value": "gazole",
              "label": {
                "en": "Diesel",
                "fr": "Gazole"
              }
            },
            {
              "value": "sp95",
              "label": {
                "en": "SP95",
                "fr": "SP95"
              }
            },
            {
              "value": "sp98",
              "label": {
                "en": "SP98",
                "fr": "SP98"
              }
            },
            {
              "value": "e10",
